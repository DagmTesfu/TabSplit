# TabSplit server configuration — copy to .env and fill in real values.
# Never commit the real .env file; it is already ignored by .gitignore.
# npm run dev / npm start load .env automatically (--env-file-if-exists).

# Required for receipt extraction: OpenRouter API key (https://openrouter.ai/settings/keys).
# The receipt extraction model is openrouter/free (free-model router).
OPENROUTER_API_KEY=

# Required for bill finalization: Supabase project credentials.
# Use the service_role secret key (Project Settings -> API) — server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public base URL of the client app used to build share links
# (e.g. https://tabsplit.vercel.app). Defaults to http://localhost:5173.
PUBLIC_APP_URL=

# Optional: port for the Express server (default 4000).
PORT=4000
