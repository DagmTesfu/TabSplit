# TabSplit server configuration — copy to .env and fill in real values.
# Never commit the real .env file; it is already ignored by .gitignore.
# npm run dev / npm start load .env automatically (--env-file-if-exists).

# Required: OpenRouter API key (https://openrouter.ai/settings/keys).
# The receipt extraction model is openrouter/free (free-model router).
OPENROUTER_API_KEY=

# Optional: port for the Express server (default 4000).
PORT=4000
