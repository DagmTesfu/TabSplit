# TabSplit client configuration — copy to .env or .env.local for local overrides.
# In production, set this environment variable in your frontend hosting platform (e.g. Vercel, Netlify).

# Optional: backend API base URL (e.g. https://api.tabsplit.com or https://tabsplit-server.onrender.com).
# Leave empty for local development to use Vite's built-in dev proxy (/api -> http://localhost:4000).
# Never put API keys, service role keys, or secrets in this file or any VITE_* variable.
VITE_API_BASE_URL=
